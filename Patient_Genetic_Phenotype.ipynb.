        "```markdown\n",
        "## Create Flask API\n",
        "We will write a python file `app.py` implementing a Flask API endpoint to predict cluster groupings for new patient profiles.\n",
        "```"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "f1b0e180",
        "outputId": "4f4be46a-6f03-4d7e-94ca-8bb076eb66a8"
      },
      "source": [
        "flask_code = \"\"\"\n",
        "from flask import Flask, request, jsonify\n",
        "import joblib\n",
        "import numpy as np\n",
        "\n",
        "app = Flask(__name__)\n",
        "\n",
        "# Load scaler and model\n",
        "kmeans = joblib.load('kmeans_model.pkl')\n",
        "scaler = joblib.load('scaler.pkl')\n",
        "\n",
        "@app.route('/predict_phenotype', methods=['POST'])\n",
        "def predict_phenotype():\n",
        "    try:\n",
        "        data = request.get_json()\n",
        "        # Features mapping expected: [Patient Age, Mother Genes, Father Inherited, Maternal, Paternal, Blood Cell Count, WBC Count, Symptom 1, Symptom 2, Symptom 3, Symptom 4, Symptom 5]\n",
        "        features = np.array(data['features']).reshape(1, -1)\n",
        "        scaled_features = scaler.transform(features)\n",
        "        cluster_id = int(kmeans.predict(scaled_features)[0])\n",
        "\n",
        "        # Map clusters to human-readable phenotypes\n",
        "        mapping = {\n",
        "            0: \"Group A - High Symptom Severity, Paternal Inheritance Dominant\",\n",
        "            1: \"Group B - Younger Patients, Maternal/Paternal Marker Cleared\",\n",
        "            2: \"Group C - Elevated Blood Counts, Mid-range Symptom Score\",\n",
        "            3: \"Group D - High Maternal Genetic Mutation Risk Phenotype\"\n",
        "        }\n",
        "\n",
        "        return jsonify({\n",
        "            'cluster_id': cluster_id,\n",
        "            'phenotype_group': mapping.get(cluster_id, \"Unknown Phenotype\")\n",
        "        })\n",
        "    except Exception as e:\n",
        "        return jsonify({'error': str(e)}), 400\n",
        "\n",
        "if __name__ == '__main__':\n",
        "    app.run(host='0.0.0.0', port=5000)\n",
        "\"\"\"\n",
        "\n",
        "with open('app.py', 'w') as f:\n",
        "    f.write(flask_code)\n",
        "\n",
        "print(\"Flask application file 'app.py' saved!\")"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Flask application file 'app.py' saved!\n"
          ]
        }
      ]
    },
