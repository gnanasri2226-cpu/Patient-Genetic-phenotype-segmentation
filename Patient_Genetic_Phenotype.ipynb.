        "## Create Streamlit Dashboard Code\n",
        "We will create `dashboard.py` containing a multi-element dashboard including visualization of cluster metrics and user profile testing.\n",
        "```"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "e9e854ad",
        "outputId": "74bc5875-93ce-4ebc-e8af-c899ca085234"
      },
      "source": [
        "import os\n",
        "\n",
        "streamlit_code = \"\"\"\n",
        "import streamlit as st\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import joblib\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "st.set_page_config(layout='wide', page_title='Patient Phenotype Segmentation')\n",
        "st.title('🧬 Patient Genetic Phenotype Segmentation Dashboard')\n",
        "\n",
        "# Load assets\n",
        "@st.cache_data\n",
        "def load_data():\n",
        "    return pd.read_csv('segmented_patients.csv')\n",
        "\n",
        "df = load_data()\n",
        "kmeans = joblib.load('kmeans_model.pkl')\n",
        "scaler = joblib.load('scaler.pkl')\n",
        "\n",
        "# Layout definition\n",
        "col1, col2 = st.columns([1, 2])\n",
        "\n",
        "with col1:\n",
        "    st.header('Cluster Characteristics Summary')\n",
        "    st.write(df.groupby('Cluster').mean().iloc[:, 0:7])\n",
        "\n",
        "    st.subheader('Group Definition')\n",
        "    st.markdown('- **Cluster 0 (Group A)**: Moderate symptoms, average genetic risk indexes.\\\\n- **Cluster 1 (Group B)**: Low/mild symptom levels across the profile.\\\\n- **Cluster 2 (Group C)**: High symptom index patient profile.\\\\n- **Cluster 3 (Group D)**: Higher risk indicators across maternal channels.')\n",
        "\n",
        "with col2:\n",
        "    st.header('Phenotype Distribution Visualization')\n",
        "    fig, ax = plt.subplots(figsize=(6, 4))\n",
        "    sns.scatterplot(data=df, x='PCA1', y='PCA2', hue='Cluster', palette='Set1', ax=ax, alpha=0.7)\n",
        "    st.pyplot(fig)\n",
        "\n",
        "st.markdown('---')\n",
        "st.header('🩺 Interactive Patient Diagnostic Segment Finder')\n",
        "\n",
        "age = st.slider('Patient Age', 0, 100, 30)\n",
        "blood_cell = st.slider('Blood cell count (mcL)', 4.0, 6.0, 4.8)\n",
        "wbc = st.slider('White Blood cell count', 2.0, 15.0, 7.5)\n",
        "\n",
        "if st.button('Predict Cluster Segment'):\n",
        "    test_input = np.array([age, 1, 0, 1, 0, blood_cell, wbc, 1, 0, 1, 0, 0]).reshape(1, -1)\n",
        "    test_scaled = scaler.transform(test_input)\n",
        "    predicted = kmeans.predict(test_scaled)[0]\n",
        "    st.success(f'This patient is classified into Segment: Cluster {predicted}')\n",
        "\"\"\"\n",
        "\n",
        "with open('dashboard.py', 'w') as f:\n",
        "    f.write(streamlit_code.strip())\n",
        "\n",
        "print(\"Streamlit dashboard file 'dashboard.py' saved successfully!\")"
