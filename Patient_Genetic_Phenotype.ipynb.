        "outputId": "7f428a73-4658-428a-9727-f6b9408f6650"
      },
      "source": [
        "import joblib\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.decomposition import PCA\n",
        "\n",
        "# Fit final model with 4 clusters\n",
        "optimal_k = 4\n",
        "kmeans_final = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)\n",
        "cluster_labels = kmeans_final.fit_predict(scaled_df)\n",
        "\n",
        "# Add labels to original clean features for cluster interpretation\n",
        "cluster_df['Cluster'] = cluster_labels\n",
        "print(\"Patients count per cluster:\")\n",
        "print(cluster_df['Cluster'].value_counts())\n",
        "\n",
        "# Analyze cluster profiles\n",
        "profiles = cluster_df.groupby('Cluster').mean()\n",
        "display(profiles)\n",
        "\n",
        "# PCA for 2D Visualisation\n",
        "pca = PCA(n_components=2)\n",
        "pca_features = pca.fit_transform(scaled_df)\n",
        "cluster_df['PCA1'] = pca_features[:, 0]\n",
        "cluster_df['PCA2'] = pca_features[:, 1]\n",
        "\n",
        "plt.figure(figsize=(10, 7))\n",
        "sns.scatterplot(data=cluster_df, x='PCA1', y='PCA2', hue='Cluster', palette='Set1', alpha=0.6)\n",
        "plt.title('Patient Genetic Phenotype Clusters (PCA Space)')\n",
        "plt.xlabel('PCA Feature 1')\n",
        "plt.ylabel('PCA Feature 2')\n",
        "plt.legend(title='Phenotype Groups')\n",
        "plt.show()\n",
        "\n",
        "# Save the model and processing tools for Flask/Streamlit integration\n",
        "joblib.dump(kmeans_final, 'kmeans_model.pkl')\n",
        "joblib.dump(scaler, 'scaler.pkl')\n",
        "cluster_df.to_csv('segmented_patients.csv', index=False)\n",
        "print(\"Segmentation objects saved successfully!\")"
      ],
