        "```markdown\n",
        "## Elbow Method & Silhouette Analysis\n",
        "Now we will run K-Means across a range of clusters (e.g., 2 to 10) to compute the Inertia (WCSS) and Silhouette Score to find the optimal number of patient phenotypes.\n",
        "```"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 247
        },
        "id": "8705054d",
        "outputId": "5b58457c-bc4d-4df3-af74-fb101a1e5d65"
      },
      "source": [
        "from sklearn.cluster import KMeans\n",
        "from sklearn.metrics import silhouette_score\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Compute Elbow curve (Inertia) and Silhouette Scores\n",
        "wcss = []\n",
        "silhouette_scores = []\n",
        "k_range = range(2, 7) # Using a smaller range for faster computation on large dataset\n",
        "\n",
        "# Take a representative sample (e.g., 5000 records) to compute Silhouette Score faster\n",
        "sample_indices = np.random.choice(scaled_df.index, size=5000, replace=False)\n",
        "sampled_data = scaled_df.iloc[sample_indices]\n",
        "\n",
        "for k in k_range:\n",
        "    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
        "    kmeans.fit(scaled_df)\n",
        "    wcss.append(kmeans.inertia_)\n",
        "\n",
        "    # Silhouette Score on representative sample\n",
        "    labels = kmeans.predict(sampled_data)\n",
        "    score = silhouette_score(sampled_data, labels)\n",
        "    silhouette_scores.append(score)\n",
        "    print(f\"K={k} | WCSS={kmeans.inertia_:.2f} | Silhouette Score={score:.4f}\")\n",
        "\n",
        "# Plot the elbow and silhouette curve\n",
        "fig, ax1 = plt.subplots(figsize=(10, 5))\n",
        "\n",
        "color = 'tab:blue'\n",
        "ax1.set_xlabel('Number of Clusters (k)')\n",
        "ax1.set_ylabel('Inertia (WCSS)', color=color)\n",
        "ax1.plot(k_range, wcss, marker='o', color=color, linewidth=2)\n",
        "ax1.tick_params(axis='y', labelcolor=color)\n",
        "\n",
        "ax2 = ax1.twinx()\n",
        "color = 'tab:red'\n",
        "ax2.set_ylabel('Silhouette Score', color=color)\n",
        "ax2.plot(k_range, silhouette_scores, marker='s', color=color, linewidth=2, linestyle='--')\n",
        "ax2.tick_params(axis='y', labelcolor=color)\n",
        "\n",
        "plt.title('Elbow Curve & Silhouette Scores for Phenotype Clusters')\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ],
