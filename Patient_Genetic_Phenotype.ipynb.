        "features_to_keep = [\n",
        "    'Patient Age',\n",
        "    'Genes in mother\\'s side',\n",
        "    'Inherited from father',\n",
        "    'Maternal gene',\n",
        "    'Paternal gene',\n",
        "    'Blood cell count (mcL)',\n",
        "    'White Blood cell count (thousand per microliter)',\n",
        "    'Symptom 1',\n",
        "    'Symptom 2',\n",
        "    'Symptom 3',\n",
        "    'Symptom 4',\n",
        "    'Symptom 5'\n",
        "]\n",
        "\n",
        "# Filter the dataframe to only include our features of interest\n",
        "cluster_df = df[features_to_keep].copy()\n",
        "\n",
        "# Handle missing values: Fill numerical features with median and categorical with mode\n",
        "for col in cluster_df.columns:\n",
        "    if cluster_df[col].dtype in ['float64', 'int64']:\n",
        "        cluster_df[col] = cluster_df[col].fillna(cluster_df[col].median())\n",
        "    else:\n",
        "        cluster_df[col] = cluster_df[col].fillna(cluster_df[col].mode()[0])\n",
        "\n",
        "# Encode categorical variables\n",
        "label_encoders = {}\n",
        "for col in cluster_df.columns:\n",
        "    if cluster_df[col].dtype == 'object':\n",
        "        le = LabelEncoder()\n",
        "        cluster_df[col] = le.fit_transform(cluster_df[col].astype(str))\n",
        "        label_encoders[col] = le\n",
        "\n",
        "# Standardize numerical features\n",
        "scaler = StandardScaler()\n",
        "scaled_features = scaler.fit_transform(cluster_df)\n",
        "\n",
        "# Convert to a clean DataFrame\n",
        "scaled_df = pd.DataFrame(scaled_features, columns=cluster_df.columns)\n",
